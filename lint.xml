<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- Fixed compatibility baseline; upgrading JDBC jre8 to jre11 is not an Android fix. -->
    <issue id="NewerVersionAvailable" severity="ignore" />
    <!-- Reviewed upstream optional TRUST-mode manager; our mandatory StrictTlsPlugin never
         selects it. Exact artifact only. Hostname and untrusted-CA integration regressions
         must stay enabled; do not apply this exception to app code or other driver versions. -->
    <issue id="TrustAllX509TrustManager">
        <!-- Derived profile verifies these unmodified manager bytes against the same upstream. -->
        <ignore regexp=".*mariadb-java-client-android-3\.5\.10-datasail\.1\.jar.*" />
        <ignore regexp=".*mariadb-java-client-3\.5\.10\.jar.*" />
        <!-- pgjdbc NonValidatingTM and SingleCertTrustManager are upstream optional factories.
             JdbcConnector fixes sslfactory=PostgreSqlTlsFactory and sslmode=verify-full;
             callers cannot supply properties. Real CA/hostname negative tests are mandatory. -->
        <ignore regexp=".*postgresql-android-42\.7\.14-datasail\.1\.jar.*" />
        <ignore regexp=".*postgresql-42\.7\.14\.jar.*" />
    </issue>
</lint>
